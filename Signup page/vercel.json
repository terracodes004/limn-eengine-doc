{
  "rewrites": [
    {
      "source": "/callback",
      "destination": "/Signup page/frontend/callback.html"
    },
    {
      "source": "/Signup%20page/frontend/:path*",
      "destination": "/Signup page/frontend/:path*"
    },
    {
      "source": "/((?!api/|_next/|favicon.ico|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/send-weekly",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/send-monthly",
      "schedule": "0 10 1 * *"
    }
  ]
}

