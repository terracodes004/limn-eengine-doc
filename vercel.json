{
  "rewrites": [
    {
      "source": "/callback",
      "destination": "/signup/frontend/callback.html"
    },
    {
      "source": "/signup",
      "destination": "/signup/frontend/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/send-weekly",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/send-monthly",
      "schedule": "0 10 1 * *"
    }
  ]
}
